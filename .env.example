# Copia este archivo a .env y completa los valores.

# PostgreSQL (dev local: npx prisma dev --detach --name funnel-dev)
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Better Auth — genera un secreto fuerte: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# IA (server-side only, nunca en frontend)
# ANTHROPIC_API_KEY=""

# Email transaccional (opcional en dev)
# RESEND_API_KEY=""
