# Copia este archivo a .env y completa los valores.

# PostgreSQL (dev local: npx prisma dev --detach --name funnel-dev)
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Better Auth — genera un secreto fuerte: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Panel interno /admin/workspaces (activación manual de planes tras pago)
# Emails separados por coma con acceso al panel.
ADMIN_EMAILS=""

# IA (server-side only, nunca en frontend). Necesaria para "Crear con IA".
ANTHROPIC_API_KEY=""
# Modelo opcional (por defecto claude-sonnet-5)
# AI_MODEL="claude-sonnet-5"

# Email transaccional (opcional en dev)
# RESEND_API_KEY=""
